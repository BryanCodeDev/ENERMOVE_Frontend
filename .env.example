# Copia este archivo a .env solo si necesitas probar el formulario en local.
# En Netlify las variables se configuran en Site configuration > Environment variables.
# Nunca subas el archivo .env al repositorio.

# API key de Resend. Se obtiene en resend.com -> API Keys.
RESEND_API_KEY=re_TU_CLAVE_AQUI

# Destinatario de las solicitudes.
LEADS_RECIPIENT=enermovesas@gmail.com

# Remitente. Con onboarding@resend.dev solo se puede enviar al correo de la cuenta de Resend.
# Al verificar un dominio propio, cambiar por algo como "Notificaciones <notificaciones@tudominio.com>".
RESEND_FROM=onboarding@resend.dev
