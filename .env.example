# API key de Resend. Se define en el panel de Netlify (Site configuration > Environment variables),
# nunca en el repositorio. Ver README.md.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Destinatario de las solicitudes.
LEADS_RECIPIENT=mastercodecompany@gmail.com

# Remitente. Con onboarding@resend.dev solo se puede enviar al correo de la cuenta de Resend.
# Al verificar un dominio propio, cambiar por algo como "Notificaciones <notificaciones@tudominio.com>".
RESEND_FROM=onboarding@resend.dev
